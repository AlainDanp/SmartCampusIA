# Copier en .env (à la racine pour Docker, ou dans api/ pour npm run dev)
# Windows (cmd) : copy .env.example .env

# --- Sécurité ---
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# --- Base de données ---
# Local Docker : laisser vide (postgres du compose). npm run dev (base Docker) : postgres://smartcampus:smartcampus@localhost:5433/smartcampus
# AWS : endpoint RDS, ex. postgres://smartcampus:MOTDEPASSE@smartcampus-db.xxxx.us-west-2.rds.amazonaws.com:5432/smartcampus
DATABASE_URL=
# RDS PostgreSQL 15+ impose SSL : true sur AWS, false en local
PGSSL=false

# --- AWS (identifiants fournis par le rôle IAM de l'EC2, aucune clé ici) ---
AWS_REGION=us-west-2
# Vide = photos sur disque local (plan B)
S3_BUCKET=
MAX_PHOTO_MB=5

# --- Assistant IA ---
# Vide = repli FAQ par mots-clés (plan B). Copier l'ID du modèle (ou du profil d'inférence)
# depuis la console Bedrock → Model catalog, ex. un modèle Claude Haiku.
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-west-2

# --- RG-06 : fréquence de la tâche de relance des tickets > 24 h (minutes) ---
RELANCE_INTERVAL_MIN=15
